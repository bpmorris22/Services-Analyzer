<!doctype html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Services Analyzer</title>
<HTA:APPLICATION
  ID="saHta"
  APPLICATIONNAME="Services Analyzer"
  BORDER="thick"
  CAPTION="yes"
  SCROLL="auto"
  SINGLEINSTANCE="yes"
  SHOWINTASKBAR="yes"
  MAXIMIZEBUTTON="yes"
  MINIMIZEBUTTON="yes"
  INNERBORDER="no"
  CONTEXTMENU="yes"
  SELECTION="yes" />
<!--
  Services-Analyzer - Windows services triage for the DFIR toolkit (github.com/bpmorris22/Services-Analyzer).
  Every service the SYSTEM hive configures, JOINED to its install history from the System / Security
  event logs, scored for persistence and remote-execution tradecraft. The join is the point: a service
  that was installed (7045 / 4697) and is no longer in the hive is a transient / deleted service
  (PsExec, smbexec, sc-create one-shots) that a hive-only or log-only tool cannot see.

  Engines (both Eric Zimmerman tools, both folder-shaped):
    RECmd.exe    --bn "<outDir>\ServicesAnalyzer.reb" -f "<SYSTEM>" --csv "<outDir>" [--nl]
    EvtxECmd.exe -f "<System.evtx>"   --csv "<outDir>" --csvf <stamp>_ServicesAnalyzer_SystemLog.csv   --inc 7045,7040,7034,7031,7030,7023,7024,7000,7009
    EvtxECmd.exe -f "<Security.evtx>" --csv "<outDir>" --csvf <stamp>_ServicesAnalyzer_SecurityLog.csv --inc 4697

  Output contract VERIFIED 2026-10-03 (RECmd 2.0.0.0, EvtxECmd 1.0.0.0, two real workstation / server collections):
    <rstamp>_RECmd_Batch_ServicesAnalyzer_Output.csv       batch rows (Select\Current, ComputerName,
                                                            ObjectName, FailureCommand, ServiceMain)
    <rstamp>\<rstamp>_Services__SYSTEM.csv                  Services plugin detail, one row per service:
      Name,BatchKeyPath,Description,BatchValueName,DisplayName,StartMode,ServiceType,NameKeyLastWrite,
      ParametersKeyLastWrite,Group,ImagePath,ServiceDLL,RequiredPrivileges
      join key to batch rows = BatchKeyPath + "\" + Name == KeyPath (ROOT\ControlSet001\Services\<Name>)
    EvtxECmd: RecordNumber,...,EventId,...,Computer,...,UserId,MapDescription,UserName,...,PayloadData1..6,
      ExecutableInfo,...,Payload   - Payload is JSON {"EventData":{"Data":[{"@Name":..,"#text":..}],"Binary":..}}
      with XML entities still escaped (&gt; &amp;) - decoded at ingest. 7045 ServiceName is the DISPLAY name
      when one was supplied; SCM failure events (7024/7031/7034) carry the KEY name UTF-16LE in Binary.
  RECmd crashes on a bare no-arg run (Console.WindowWidth) - versions are read with --version.
  Dirty hive without .LOG1/.LOG2: RECmd aborts with no CSV -> the app retries the RECmd step once with --nl.
-->
<style>
  html{margin:0;height:100%;background:#0d1117}
  body{margin:0;height:100%;background:#0d1117;color:#e6edf3;font-family:Segoe UI,Tahoma,sans-serif;font-size:16px}
  #content{zoom:0.9;width:111.111%;box-sizing:border-box}   /* zoom<1 shrinks a 100%-wide block below viewport width - widen by 1/zoom in CSS so it fills the window from the first paint (applyZoom keeps it in sync for A-/A+) */
  a{color:#58a6ff}
  .mono{font-family:Consolas,"Courier New",monospace}
  .muted{color:#8b949e}
  .err{color:#f85149}
  .ok{color:#3fb950}
  .warn{color:#e3b341}
  header{padding:8px 14px;background:#161b22;border-bottom:1px solid #30363d}
  header h1{display:inline-block;font-size:15px;margin:0;font-weight:600;vertical-align:middle}
  header h1 small{color:#8b949e;font-weight:400}
  .pill{display:inline-block;font-size:11px;color:#8b949e;border:1px solid #30363d;border-radius:20px;padding:2px 10px;margin-left:8px;vertical-align:middle}
  .pill.run{color:#ff8b3d;border-color:#bd561d}     /* orange: a run is in progress */
  .pill.err{color:#ff8b8b;border-color:#b02020}     /* red: the run timed out / produced nothing */
  .pill.ok{color:#7ee787;border-color:#2ea043}
  .pill.bad{color:#ff8b3d;border-color:#bd561d}
  .wrap{padding:12px 14px}
  .card{background:#161b22;border:1px solid #30363d;border-radius:8px;padding:12px;margin-bottom:12px}
  .card h3{margin:0 0 8px;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#8b949e}
  label.fld{display:block;margin:6px 0 2px;font-size:11px;color:#8b949e}
  input.txt,select,textarea{background:#1c2330;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:5px 8px;font-size:13px;font-family:Consolas,monospace}
  input.wide{width:62%}
  .btn{background:#1c2330;border:1px solid #30363d;color:#e6edf3;border-radius:6px;padding:6px 12px;font-size:13px;cursor:pointer;margin:2px}
  .btn:hover{border-color:#58a6ff}
  .btn.primary{background:#1f6feb;border-color:#1f6feb}
  .btn.on{background:#1f6feb;border-color:#1f6feb;color:#fff}
  .btn.sm{padding:3px 9px;font-size:12px}
  .row{white-space:nowrap}
  .chiplab{display:inline-block;width:58px;font-size:11px;color:#8b949e;text-transform:uppercase;letter-spacing:.4px}
  .stat{display:inline-block;background:#1c2330;border:1px solid #30363d;border-radius:8px;padding:6px 12px;margin:0 6px 6px 0;min-width:70px;vertical-align:top}
  .stat .n{font-size:17px;font-weight:700;display:block}
  .stat .l{font-size:10px;color:#8b949e;text-transform:uppercase;letter-spacing:.5px}
  .cards3{width:100%}
  .col3{display:inline-block;width:32%;vertical-align:top;margin-right:1%}
  .brow{white-space:nowrap;margin:3px 0}
  .blab{display:inline-block;width:46%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;font-family:Consolas,monospace;font-size:11px}
  .blab.lnk{cursor:pointer;color:#58a6ff}
  .blab.lnk:hover{text-decoration:underline}
  .btrack{display:inline-block;width:32%;height:12px;background:#1c2330;border-radius:3px;overflow:hidden;vertical-align:middle}
  .bfill{display:block;height:100%;background:#1f6feb}
  .bval{display:inline-block;width:18%;text-align:right;font-size:11px;color:#8b949e;vertical-align:middle}
  table{width:100%;border-collapse:collapse;font-size:12px}
  th,td{text-align:left;padding:4px 7px;border-bottom:1px solid #30363d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  th{background:#1c2330;cursor:pointer;color:#c9d1d9;position:relative;z-index:3;box-shadow:0 1px 0 #30363d}
  th:hover{color:#58a6ff}
  .cgrip{position:absolute;top:0;right:-4px;width:8px;height:100%;cursor:col-resize;z-index:6}
  .cgrip:hover{background:#58a6ff;filter:alpha(opacity=45);opacity:.45}
  td{max-width:360px}
  tr.sus td{background:#2a1416}
  tr.sus td.first{border-left:3px solid #ff6b6b}
  tr.sel td{background:#1c2f4a}
  tr.clus td{color:#8b949e;font-style:italic}
  .scroll{max-height:52vh;overflow:auto;border:1px solid #30363d;border-radius:8px;width:100%;box-sizing:border-box}
  .tag{display:inline-block;font-size:10px;padding:1px 6px;border-radius:10px;font-weight:600;margin-right:3px}
  .tag.sus{background:#3a1416;color:#ff6b6b}
  .tag.usr{background:#3a2d10;color:#d29922}
  .tag.lol{background:#10263f;color:#58a6ff}
  .tag.rare{background:#241a3a;color:#b083f0}
  .tag.ioc{background:#3a1416;color:#ff6b6b;border:1px solid #ff6b6b}
  .tag.gen{background:#21262d;color:#8b949e}
  .tag.ctx{background:transparent;color:#6e7681;border:1px dashed #30363d;font-weight:400}
  .tag.cnt{background:#1c2330;color:#c9d1d9;border:1px solid #30363d}
  .dl{font-family:Consolas,"Courier New",monospace;font-size:11px;max-height:210px;overflow:auto;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:6px;margin:4px 0;white-space:nowrap;width:100%;box-sizing:border-box}
  .dl div{overflow:hidden;text-overflow:ellipsis}
  .hl-user{color:#d29922}
  .hl-ioc{color:#ff6b6b;font-weight:700}
  #log{white-space:pre-wrap;font-family:Consolas,monospace;font-size:11px;color:#8b949e;max-height:140px;overflow:auto;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:8px;display:none;margin-top:8px;width:100%;box-sizing:border-box}
  .hide{display:none !important}   /* must beat later single-class display rules (.maxwarn is inline-block) */
  .lnk{cursor:pointer;color:#58a6ff}
  .lnk:hover{text-decoration:underline}
  .sep{display:inline-block;width:1px;height:18px;background:#30363d;margin:0 6px;vertical-align:middle}
  .modal{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.66);z-index:1000;overflow:auto}
  .modal .mcard{max-width:820px;margin:36px auto;background:#161b22;border:1px solid #30363d;border-radius:10px;padding:18px 22px}
  .modal h2{margin:0 0 6px;font-size:18px;font-weight:600}
  .modal h3{margin:12px 0 4px;font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:#8b949e}
  .modal ul{margin:4px 0;padding-left:20px}.modal li{margin:3px 0;font-size:13px}
  .modal p{font-size:13px;margin:6px 0}
  .modal code{background:#0d1117;border:1px solid #30363d;border-radius:4px;padding:2px 6px;font-family:Consolas,monospace;font-size:12px}
  .modal .x{float:right;cursor:pointer;color:#8b949e;font-size:22px;line-height:1}.modal .x:hover{color:#e6edf3}
  .modal .gh{font-family:Consolas,monospace;font-size:12px}
  .maxwarn{display:inline-block;color:#e3b341;font-weight:600;cursor:help;border:1px solid #8a7a2a;background:#2a2410;border-radius:10px;padding:1px 8px;font-size:11px;margin-left:6px;vertical-align:middle}
</style>
</head>
<body>
<header>
  <h1>Services Analyzer <small>&mdash; Windows services triage (SYSTEM hive + install history)</small></h1>
  <span class="pill" id="apppill" title="This app's version">app: checking&hellip;</span>
  <span class="pill" id="verpill" title="RECmd.exe version (SYSTEM hive, Services plugin)">RECmd: checking&hellip;</span>
  <span class="pill" id="evpill" title="EvtxECmd.exe version (System / Security event logs)">EvtxECmd: checking&hellip;</span>
  <span class="pill" id="srcpill">no data loaded</span>
  <span style="float:right">
    <span class="pill" id="procTimer" title="Processing time. Starts when a run begins and stops when it finishes, so you can see how long the sources actually took to parse. The app is single-threaded, so the counter can pause during a heavy step (a large Security.evtx, a hive replay) and then jump forward - that is the step blocking, not a stall." style="min-width:150px;text-align:center;display:inline-block">Idle</span>
    <button class="btn" id="instrBtn" onclick="openInstructions()" title="Download the latest Services Analyzer HTML manual from GitHub and open it in your browser">Instructions</button>
    <button class="btn" id="helpBtn" onclick="openHelp()" title="Help, about &amp; GitHub link">Help</button>
    <button class="btn primary hide" id="selfUpd" onclick="doSelfUpdate()" title="A newer version is available on GitHub">Update</button>
    <button class="btn" id="fdown" title="Smaller text">A&minus;</button>
    <button class="btn" id="fup" title="Larger text">A+</button>
  </span>
</header>

<div class="wrap" id="content">

  <!-- CONTROL PANEL -->
  <div class="card">
    <h3>Services Analyzer control panel</h3>
    <div class="muted" id="exeline" style="font-size:11px;margin-bottom:6px"></div>
    <label class="fld" title="A collection / host folder (searched recursively for config\SYSTEM and winevt\Logs\System.evtx / Security.evtx - KAPE and Velociraptor trees work as-is), a single SYSTEM hive, or a System.evtx / Security.evtx. The three source boxes below are filled in for you; edit any of them before processing.">Input &mdash; a collection / host folder, a SYSTEM hive, or an event log (the sources below are located automatically)</label>
    <input class="txt wide" id="inPath" value="">
    <input type="file" id="inPick" style="display:none">
    <button class="btn" id="browseBtn">Folder&hellip;</button>
    <button class="btn" id="browseFileBtn">File&hellip;</button>
    <button class="btn" id="locateBtn" title="Search the input for the SYSTEM hive and the System / Security event logs">Locate sources</button>
    <div id="hiveSelRow" class="hide">
      <label class="fld">Several SYSTEM hives found &mdash; pick one (one host per run; newest collection first)</label>
      <select id="hiveSel" style="min-width:70%"></select>
    </div>
    <label class="fld" title="The services configuration: every service + driver, binary, ServiceDLL, run-as account, start mode, key LastWrite. Read with RECmd's Services plugin. Live config hives are exclusively locked - point at a collected copy.">SYSTEM hive &mdash; services configuration (RECmd, Services plugin)</label>
    <input class="txt wide" id="hivePath" value="">
    <button class="btn" data-pick="hivePath">Browse&hellip;</button>
    <label class="fld" title="7045 service installs, 7040 start-type changes, 7031/7034 crashes, 7000/7009/7023/7024/7030 start failures. Optional - without it the run is hive-only.">System.evtx &mdash; installs (7045), start-type changes (7040), crashes / failures &mdash; optional</label>
    <input class="txt wide" id="sysPath" value="">
    <button class="btn" data-pick="sysPath">Browse&hellip;</button>
    <label class="fld" title="4697 service installs - only present where 'Security System Extension' auditing is on, but names the installing account. Optional.">Security.evtx &mdash; installs (4697, names the installing account) &mdash; optional</label>
    <input class="txt wide" id="secPath" value="">
    <button class="btn" data-pick="secPath">Browse&hellip;</button>
    <input type="file" id="srcPick" style="display:none">
    <label class="fld" title="Required before processing. Guessed from the input path (Collection-<host>-... segments) - overwrite it if the guess is wrong. Cross-checked against the hive's own ComputerName after a run.">Target hostname (required) &mdash; names the output folder _Processed\&lt;host&gt;\Services-Analyzer next to this app</label>
    <input class="txt" id="hostName" value="" style="width:260px" placeholder="e.g. WORKSTATION-01">
    <span id="hostWarn" class="maxwarn hide"></span>
    <label class="fld">CSV output directory</label>
    <input class="txt wide" id="outDir" value="">
    <button class="btn" id="openDirBtn">Open folder</button>
    <div style="margin-top:10px">
      <button class="btn" id="verBtn">Check versions</button>
      <button class="btn" id="updBtn">Update / download RECmd</button>
      <button class="btn" id="updEvBtn">Update / download EvtxECmd</button>
      <span class="sep"></span>
      <button class="btn primary" id="procBtn">Process &rarr; analyze</button>
      <button class="btn" id="loadBtn" title="Load a previous run: any CSV this app produced reloads the whole run (via runinfo.json); other CSVs open in the generic table view.">Load existing run / CSV&hellip;</button>
      <input type="file" id="csvPick" style="display:none">
      <span class="sep"></span>
      <button class="btn" id="logToggle">Show log</button>
      <span class="muted" id="status" style="margin-left:8px"></span>
    </div>
    <div style="margin-top:8px" id="producedRow" class="hide">
      <label class="fld">Produced CSVs &mdash; pick one to reload (the run's CSVs load together)</label>
      <select id="producedSel" style="min-width:70%"></select>
      <button class="btn" id="loadSelBtn">Load selected</button>
    </div>
    <div id="log"></div>
  </div>

  <!-- RESULTS -->
  <div id="results" class="hide">
    <div class="card">
      <h3 id="ovTitle">Overview</h3>
      <div id="statbar"></div>
    </div>

    <div class="card cards3 hide" id="pfCards">
      <div class="col3"><h3>Installs by service (7045 / 4697)</h3><div id="topExes"></div></div>
      <div class="col3"><h3>Recent lone key writes (LastWrite)</h3><div id="topNew"></div></div>
      <div class="col3"><h3>Suspicious services</h3><div id="topSus"></div></div>
    </div>

    <div class="card">
      <h3 id="tableTitle">Records</h3>
      <div class="row hide" style="margin-bottom:8px" id="viewToggle">
        <button class="btn on" id="vSvc" title="One row per service (current control set + services only in another set + services seen only in the event logs), ranked by suspicion score">Services</button>
        <button class="btn" id="vTime" title="Installs, start-type changes, crashes / failures and service-key writes on one stream, newest first. Bulk key rewrites (servicing) collapse into one row.">Timeline</button>
        <button class="btn" id="vAcct" title="Grouped per run-as account (ObjectName). Click a group to filter the Services view to it.">Accounts</button>
      </div>
      <div class="row hide" style="margin-bottom:6px" id="pfCats">
        <span class="chiplab">tags</span>
        <button class="btn sm on" data-cat="all">All</button>
        <button class="btn sm" data-cat="sus">Suspicious</button>
        <button class="btn sm" data-cat="IOC">IOC hits</button>
        <button class="btn sm" data-cat="REMOTE-EXEC">Remote exec</button>
        <button class="btn sm" data-cat="LOLBIN">LOLBin</button>
        <button class="btn sm" data-cat="USERPATH">User path</button>
        <button class="btn sm" data-cat="USER-INSTALL">User install</button>
        <button class="btn sm" data-cat="DEFENSE-OFF">Defense off</button>
      </div>
      <div class="row hide" style="margin-bottom:8px" id="pfFilt">
        <span class="chiplab">type</span>
        <button class="btn sm on" data-tf="all">All</button>
        <button class="btn sm" data-tf="win32">Win32</button>
        <button class="btn sm" data-tf="driver">Drivers</button>
        <span class="sep"></span><span class="chiplab">start</span>
        <button class="btn sm on" data-sf="all">All</button>
        <button class="btn sm" data-sf="auto">Autostart</button>
        <button class="btn sm" data-sf="manual">Manual</button>
        <button class="btn sm" data-sf="disabled">Disabled</button>
        <span class="sep"></span><span class="chiplab">source</span>
        <button class="btn sm on" data-rf="all">All</button>
        <button class="btn sm" data-rf="hive">Hive</button>
        <button class="btn sm" data-rf="hivelog">Hive+Log</button>
        <button class="btn sm" data-rf="logonly">Log-only</button>
      </div>
      <div class="row" style="margin-bottom:8px">
        <input class="txt" id="q" placeholder="search all columns&hellip;" style="width:280px">
        <span id="userWrap" class="hide"><span class="sep"></span><label class="muted" style="font-size:12px">account:</label>
          <select id="userSel" title="Filter by the service's run-as account (ObjectName in the hive, or the account named by the install event). Native per-row data. Drivers and services with no ObjectName group under (drivers / no account)."><option value="">All accounts</option></select></span>
        <span id="srcWrap" class="hide"><span class="sep"></span><label class="muted" style="font-size:12px">source:</label>
          <select id="srcSel" title="Filter by source file."><option value="">all source files</option></select></span>
        <span id="pfDateCtl" class="hide">
          <span class="sep"></span>
          <input class="txt mono" id="dfrom" placeholder="from YYYY-MM-DD" style="width:140px" title="Activity window (UTC): a service passes when its key LastWrite, an install or a start-type change falls inside; Timeline items filter on their own time">
          <span class="muted">&rarr;</span>
          <input class="txt mono" id="dto" placeholder="to YYYY-MM-DD" style="width:140px" title="Activity window (UTC): a service passes when its key LastWrite, an install or a start-type change falls inside; Timeline items filter on their own time">
        </span>
        <span class="sep"></span>
        <button class="btn" id="iocBtn">IOC / keywords&hellip;</button>
        <button class="btn" id="clearBtn">clear</button>
        <button class="btn" id="exportBtn">Export view &rarr; CSV</button>
        <button class="btn" id="copyBtn">Copy for case notes</button>
        <span class="muted" id="count" style="margin-left:8px"></span>
      </div>
      <div id="iocWrap" class="hide" style="margin-bottom:8px">
        <label class="fld">IOC / keyword list &mdash; comma or newline separated; matched (case-insensitive substring) against service name, display name, image path, ServiceDLL, failure command and account. Matches score +3 and light up red in the detail pane.</label>
        <textarea id="iocBox" rows="3" style="width:70%;vertical-align:top"></textarea>
        <button class="btn" id="iocApply">Apply</button>
        <button class="btn" id="iocLoad">Load file&hellip;</button>
        <input type="file" id="iocPick" style="display:none">
        <span class="muted" id="iocInfo" style="font-size:11px"></span>
      </div>
      <div class="scroll" id="tblScroll"><table id="tbl"></table></div>
      <div class="muted" id="pfFoot" style="font-size:11px;margin-top:6px">All timestamps UTC. Suspicious rows are shaded (heuristic score &ge; 3 - see Help for every rule). Key LastWrite is NOT install time: servicing rewrites hundreds of service keys in the same second, so those carry a dashed BULK tag and never count as recent. Source: Hive = configured only, Hive+Log = configured and its install was logged, Log-only = installed per 7045 / 4697 but no longer in the hive (transient or deleted). Click a row for every field and the matched events; click an Account cell to filter. Max 6000 rows shown; export writes the full filtered set.</div>
    </div>

    <div class="card hide" id="detailCard">
      <h3>Record detail <span class="lnk" id="detCopy" style="float:right;margin-left:12px">copy record</span><span class="lnk" id="detClose" style="float:right">close &times;</span></h3>
      <div id="detBody"></div>
    </div>
  </div>

</div>

<script language="JScript">
"use strict";

/* boot/error trace (family pattern, from the Artifact-Finder) - survives a crash where the UI can't be
   seen; overwritten each launch. The headless E2E greps it for ONERROR lines. */
var BOOTLOG="";
function bootLog(msg){
  try{
    var fso=new ActiveXObject("Scripting.FileSystemObject");
    if(!BOOTLOG){ var dir="";
      try{ var lp=decodeURIComponent(location.pathname+"").replace(/^\//,"").replace(/\//g,"\\"); dir=lp.substring(0,lp.lastIndexOf("\\")); }catch(e0){}
      if(!dir) dir=fso.GetSpecialFolder(2)+"";
      BOOTLOG=dir+"\\Services-Analyzer.boot.log";
      var f0=fso.CreateTextFile(BOOTLOG,true); f0.WriteLine(new Date()+" boot"); f0.Close(); }
    var f=fso.OpenTextFile(BOOTLOG,8,true); f.WriteLine(new Date()+" "+msg); f.Close();
  }catch(e){}
}
window.onerror=function(msg,url,line){ bootLog("ONERROR line "+line+": "+msg); return false; };
bootLog("script top-level reached");

var APP_VERSION = "0.2.2";
var APP_NAME = "Services-Analyzer";      // output folder _Processed\<host>\Services-Analyzer (no -Wrapper suffix to strip)
var KNOWN_LATEST_RECMD = "2026.5.0";     // EZ site CalVer, verified 2026-07-11 (exe --version still banners SemVer 2.0.0.0)
var RECMD_ZIP_URL = "https://download.ericzimmermanstools.com/RECmd.zip";       // official EZ mirror (net4; family default - folder-shaped tool)
var EVTX_ZIP_URL = "https://download.ericzimmermanstools.com/EvtxECmd.zip";     // HTTP 200 verified 2026-10-03 (folder-shaped: exe + Maps\)
var EZ_PAGE = "https://ericzimmerman.github.io/";                              // for live latest-version lookup
var EXE = "", EXE_DIR = "", LOCAL_VER = "", LATEST_VER = "";                    // RECmd
var EVX = "", EVX_DIR = "", EVX_VER = "", EVX_LATEST = "";                      // EvtxECmd
